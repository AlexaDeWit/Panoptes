{
  "name": "@saerskriven/render",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pdf": {
      "types": "./src/pdf.ts",
      "import": "./src/pdf.ts",
      "default": "./src/pdf.ts"
    },
    "./png": {
      "types": "./src/png.ts",
      "import": "./src/png.ts",
      "default": "./src/png.ts"
    },
    "./resvg": {
      "types": "./src/resvg.ts",
      "import": "./src/resvg.ts",
      "default": "./src/resvg.ts"
    },
    "./build-assets": {
      "types": "./src/build-assets.ts",
      "import": "./src/build-assets.ts",
      "default": "./src/build-assets.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-web-compiler": "catalog:",
    "@saerskriven/canvas": "workspace:*",
    "@saerskriven/model": "workspace:*",
    "@types/mdast": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "remark-stringify": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@types/jsdom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:"
  },
  "nx": {
    "tags": [
      "layer:render"
    ],
    "targets": {
      "boundaries": {},
      "lint": {},
      "test": {
        "inputs": [
          "...",
          {
            "env": "SAERSKRIVEN_RESVG_WASM"
          },
          "{workspaceRoot}/test-data/ecluse.model.json",
          "{workspaceRoot}/test-data/every-glyph.model.json",
          "{workspaceRoot}/test-data/saerskriven.model.json",
          "{workspaceRoot}/test-data/render/**/*",
          {
            "env": "SAERSKRIVEN_FONTS_DIR"
          }
        ]
      }
    }
  }
}
