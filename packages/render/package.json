{
  "name": "@saerskriven/render",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pdf": {
      "types": "./src/pdf.ts",
      "import": "./src/pdf.ts",
      "default": "./src/pdf.ts"
    },
    "./build-assets": {
      "types": "./src/build-assets.ts",
      "import": "./src/build-assets.ts",
      "default": "./src/build-assets.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-web-compiler": "catalog:",
    "@saerskriven/canvas": "workspace:*",
    "@saerskriven/model": "workspace:*",
    "@types/mdast": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "remark-stringify": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@types/jsdom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:"
  },
  "//": [
    "test deviates from the root dependsOn (CODING.md, Build targets) to name @saerskriven/formats' suite: markdown-register.spec.ts, svg-document.spec.tsx and typst-document.spec.ts read test-data/saerskriven.model.json and that suite is what writes it. The layer matrix forbids a package dependency on formats, so ^test cannot reach it, and a dependsOn entry naming the task orders the two with no import. The root's own entries are repeated because a leaf dependsOn replaces the default rather than adding to it."
  ],
  "nx": {
    "tags": [
      "layer:render"
    ],
    "targets": {
      "boundaries": {},
      "lint": {},
      "test": {
        "dependsOn": [
          "^build",
          "^test",
          {
            "projects": [
              "@saerskriven/formats"
            ],
            "target": "test"
          }
        ]
      }
    }
  }
}
