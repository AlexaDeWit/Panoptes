{
  "name": "@panoptes/formats",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@panoptes/model": "workspace:*",
    "@panoptes/wire-panoptes-yaml": "workspace:*",
    "@panoptes/wire-threat-dragon": "workspace:*",
    "effect": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "ajv": "catalog:",
    "fast-check": "catalog:"
  },
  "nx": {
    "tags": [
      "layer:formats"
    ],
    "targets": {
      "boundaries": {},
      "lint": {},
      "test": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/docs/panoptes-yaml.md"
        ]
      }
    }
  }
}
