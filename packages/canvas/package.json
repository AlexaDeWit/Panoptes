{
  "name": "@saerskriven/canvas",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/lib/tokens.ts",
      "import": "./src/lib/tokens.ts",
      "default": "./src/lib/tokens.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@saerskriven/model": "workspace:*",
    "@xyflow/react": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-dom": "catalog:"
  },
  "nx": {
    "tags": [
      "layer:canvas"
    ],
    "targets": {
      "boundaries": {},
      "lint": {},
      "test": {
        "inputs": [
          "...",
          "viteGlobals",
          "{workspaceRoot}/test-data/ecluse.model.json",
          "{workspaceRoot}/test-data/every-glyph.model.json",
          "{workspaceRoot}/test-data/saerskriven.model.json"
        ]
      }
    }
  }
}
