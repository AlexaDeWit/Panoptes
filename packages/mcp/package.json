{
  "name": "@saerskriven/mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures.ts",
      "import": "./src/fixtures.ts",
      "default": "./src/fixtures.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@saerskriven/formats": "workspace:*",
    "@saerskriven/model": "workspace:*",
    "@saerskriven/render": "workspace:*",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:"
  },
  "nx": {
    "tags": [
      "layer:mcp"
    ],
    "targets": {
      "boundaries": {},
      "lint": {},
      "test": {
        "inputs": [
          "...",
          {
            "env": "SAERSKRIVEN_RESVG_WASM"
          },
          {
            "env": "SAERSKRIVEN_FONTS_DIR"
          },
          "{workspaceRoot}/test-data/ecluse.json",
          "{workspaceRoot}/test-data/saerskriven/ecluse.yaml",
          "{workspaceRoot}/test-data/otm/**/*",
          "{workspaceRoot}/test-data/tmbom/**/*",
          "{workspaceRoot}/threat-modelling/saerskriven.yaml"
        ]
      }
    }
  }
}
