{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    // Every JavaScript-backed task reads the pinned Node runtime and locale.
    "sharedGlobals": [
      { "runtime": "node --version" },
      { "env": "LANG" },
      { "env": "LC_ALL" }
    ],
    // Root configuration imported by Vitest configurations.
    "testConfiguration": [
      "{workspaceRoot}/vitest.shared.mts",
      "{workspaceRoot}/workspace-version.mts",
      { "json": "{workspaceRoot}/package.json", "fields": ["version"] }
    ],
    "testFixtures": [
      "{workspaceRoot}/test-data/**/*",
      "{workspaceRoot}/threat-modelling/**/*"
    ],
    "cliTestFixtures": [
      "{workspaceRoot}/test-data/ecluse.json",
      "{workspaceRoot}/test-data/saerskriven/ecluse.yaml",
      "{workspaceRoot}/test-data/adversarial/deep-nesting.json",
      "{workspaceRoot}/test-data/adversarial/typst-injection.yaml",
      "{workspaceRoot}/test-data/absent.json",
      "{workspaceRoot}/test-data/render/**/*",
      "{workspaceRoot}/threat-modelling/saerskriven.yaml"
    ],
    "studioTestFixtures": [
      "{workspaceRoot}/test-data/otm/**/*",
      "{workspaceRoot}/test-data/ecluse.json",
      "{workspaceRoot}/test-data/threat-dragon/schema/threat-dragon-v2.schema.json",
      "{workspaceRoot}/threat-modelling/saerskriven.yaml"
    ],
    "studioE2eFixtures": [
      "{workspaceRoot}/test-data/otm/**/*",
      "{workspaceRoot}/test-data/ecluse.json",
      "{workspaceRoot}/test-data/ecluse.model.json",
      "{workspaceRoot}/test-data/saerskriven/ecluse.yaml",
      "{workspaceRoot}/test-data/render/**/*"
    ],
    // Root configuration imported by the studio's Vite configuration.
    "viteGlobals": ["testConfiguration", "{workspaceRoot}/vite.shared.mts"]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      // CI runs the same non-atomized test target as contributors. No
      // ciTargetName means the plugin exposes no second target family with a
      // different cache contract.
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "watch"
      }
    },
    {
      // The Playwright plugin defaults this name when the option is absent.
      // An empty name disables the unused atomized targets.
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": ""
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "vite:typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    }
  ],
  "analytics": false,
  "targetDefaults": {
    "test": {
      "inputs": ["...", "testConfiguration"],
      "options": {
        "...": true,
        "env": {
          "CI": "true"
        }
      }
    },
    "typecheck": {
      "inputs": [
        "...",
        "sharedGlobals",
        { "externalDependencies": ["typescript"] }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "externalDependencies": ["oxlint", "oxlint-tsgolint"]
        }
      ],
      "options": {
        "command": "oxlint {projectRoot}"
      }
    },
    "boundaries": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": [
            "eslint",
            "@nx/eslint-plugin",
            "@typescript-eslint/parser"
          ]
        }
      ],
      "options": {
        "command": "eslint {projectRoot}"
      }
    },
    "e2e": {
      "inputs": [
        "default",
        "^production",
        "^{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/scripts/preview-studio-pages.sh",
        "{workspaceRoot}/tsconfig.base.json",
        "viteGlobals",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions", "extends", "files", "include"]
        },
        {
          "externalDependencies": [
            "@playwright/test",
            "vite",
            "@vitejs/plugin-react"
          ]
        },
        {
          "env": "PLAYWRIGHT_DRIVER_VERSION"
        },
        {
          "env": "PLAYWRIGHT_BROWSERS_PATH"
        },
        {
          "env": "CI"
        },
        {
          "env": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS"
        },
        {
          "env": "PAGES_BASE_PATH"
        },
        {
          "env": "PAGES_SITE_URL"
        },
        { "env": "SAERSKRIVEN_RELEASE_TAG" },
        // The Pages export compiles with fonts outside the repository. Their
        // store path changes when the pinned nixpkgs input changes.
        {
          "env": "SAERSKRIVEN_FONTS_DIR"
        }
      ]
    },
    // Sourcemaps go through the executor's own option rather than through
    // esbuildOptions: the executor refuses esbuildOptions and esbuildConfig
    // together, and a project whose bundle needs a value computed at build
    // time (apps/cli stamps the workspace version) has only the config file.
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["extends", "files", "include"]
        },
        "{workspaceRoot}/workspace-version.mts",
        { "json": "{workspaceRoot}/package.json", "fields": ["version"] },
        // The CLI's bundle carries fonts the flake provides rather than files
        // in its project root, so the variable naming their store path is an
        // input: without it a nixpkgs bump that moves the fonts would replay
        // a build made from the old ones (CODING.md, Build targets).
        { "env": "SAERSKRIVEN_FONTS_DIR" }
      ],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "{projectRoot}/dist",
        "format": ["cjs"],
        "bundle": false,
        "main": "{projectRoot}/src/main.ts",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "sourcemap": true
      },
      "configurations": {
        "development": {},
        "production": {
          "sourcemap": false
        }
      }
    },
    "@nx/js:node": {
      "continuous": true,
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "{projectName}:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": { "buildTarget": "{projectName}:build:development" },
        "production": { "buildTarget": "{projectName}:build:production" }
      }
    }
  },
  // The workspace version authority (issue #50). One fixed group, so every
  // manifest carries the same number and the CLI can stamp it without asking
  // which package it belongs to. The bump comes from the conventional-commit
  // subjects since the last tag, which for a squash merge is the PR title.
  //
  // Nothing here touches git: the repository's rulesets let no actor push to
  // main outside a pull request, and every tag needs a signature with no
  // bypass. So `nx release version` writes files only, the owner lands them
  // through a PR, and the owner signs and pushes the tag by hand
  // (docs/release.md).
  "release": {
    // Named explicitly, because nx release versions only the non-private
    // projects by default. With every package private that set is empty;
    // with one package not private it versions that one alone and the other
    // manifests keep the old number with nothing said. The list versions all
    // nine and excludes the operator tooling under scripts. Nothing is
    // published; the version is what a release needs.
    "projects": ["@saerskriven/*"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "conventionalCommits": {
      // Scopes here name a layer ("cli", "model"), not a project, so scope
      // matching would read every subject as a patch.
      "useCommitScope": false
    },
    "version": {
      "conventionalCommits": true,
      "git": {
        "commit": false,
        "tag": false,
        "push": false,
        "stageChanges": false
      },
      // No tag exists before the first release, and the disk fallback lets
      // that first run resolve the current version from the manifests.
      "fallbackCurrentVersionResolver": "disk",
      // The root manifest holds the number the CLI build reads, and it is no
      // project, so each project writes it alongside its own manifest. Under
      // a fixed group they all write the same version.
      "manifestRootsToUpdate": ["{projectRoot}", "."]
    },
    "changelog": {
      "projectChangelogs": false,
      // No tag exists before the first release, so the first changelog runs
      // from the first commit instead of needing a one-off flag.
      "automaticFromRef": true,
      "git": {
        "commit": false,
        "tag": false,
        "push": false,
        "stageChanges": false
      },
      "workspaceChangelog": {
        "file": "CHANGELOG.md",
        // ci.yml's publish job creates the GitHub release from this file's
        // section for the tag, because nx would need a token and a git
        // identity the rulesets do not grant it.
        "createRelease": false
      }
    }
  }
}
