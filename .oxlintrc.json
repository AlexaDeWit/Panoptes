{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": [
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "promise",
    "react",
    "jsx-a11y",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    // Effect's tagged types discriminate on `_tag` (adopted for the model
    // package's fallible surface), and zod exposes a schema's own definition
    // under `_zod` (read by the model package's schema report). Both are the
    // library's documented member, not a reach into a private field.
    "no-underscore-dangle": ["error", { "allow": ["_tag", "_zod"] }],
    // The workspace compiles JSX with the automatic runtime ("jsx":
    // "react-jsx"), so React never needs to be in scope.
    "react/react-in-jsx-scope": "off",
    // 35 of the jsx-a11y plugin's 36 rules sit in the categories this config
    // denies above, so listing the plugin is enough to turn them on.
    // anchor-ambiguous-text is the one exception: it sits in restriction,
    // which this config does not enable, so it is named here. No jsx-a11y
    // rule is off.
    "jsx-a11y/anchor-ambiguous-text": "error",
    // Type-aware rules the categories above do not reach (they sit in
    // pedantic or restriction). Rules already denied by correctness or
    // suspicious, no-floating-promises among them, are not repeated here.
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error"
  },
  // Generated output; node_modules is ignored by default.
  "ignorePatterns": ["**/dist/**", "**/out-tsc/**", "**/coverage/**"]
}
