{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Implied by composite for tsc itself. Written out because the esbuild
    // build clears composite to type-check without emitting, and
    // declarationMap and emitDeclarationOnly are errors without one of the
    // two (apps/cli/package.json).
    "declaration": true,
    // Not dist: the esbuild build owns that directory and empties it on every
    // run, and nothing orders the two targets (CODING.md, Build targets).
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    // The esbuild build clears composite, so it compiles the render package's
    // sources in this program rather than reading its declarations, and the
    // resvg subpath names WebAssembly, which only lib.dom declares.
    // This file is also what the typecheck target reads, which needs none of
    // it and gets it anyway, so document, localStorage and window type-check
    // in a program that runs under node and deno alone and would answer a
    // ReferenceError for each. Nothing but this comment says so until the
    // narrowing lands: see the tracker issue for pointing the esbuild
    // target's tsConfig at a build-only config that extends this one.
    "lib": ["dom", "es2022"],
    "types": ["node"],
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.fixtures.ts", "src/**/*.test.ts", "src/**/*.spec.ts"],
  "references": [
    {
      "path": "../../packages/model/tsconfig.lib.json"
    },
    {
      "path": "../../packages/mcp/tsconfig.lib.json"
    },
    {
      "path": "../../packages/formats/tsconfig.lib.json"
    },
    {
      "path": "../../packages/render/tsconfig.lib.json"
    }
  ]
}
