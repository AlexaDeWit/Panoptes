{
  "name": "@saerskriven/cli",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "//": [
    "The build bundles every workspace and npm dependency as ESM for `deno compile`. It stamps the root manifest version through esbuild.config.mts.",
    "The build copies the Typst module out of node_modules, the pinned fonts out of the flake, and the resvg module out of the resvg-wasm project's output into dist/assets, so it names the fonts variable and that output among its inputs. dependsOn restates ^build because a leaf override replaces what the executor default declares. The compiled executable includes that directory.",
    "The typecheck writes declarations under out-tsc. The build writes only the bundle and its runtime assets under dist.",
    "The test target depends on build because main.spec.ts and mcp-session.spec.ts run dist/saer.js. The compiled test runs those two and the runner table's own spec, which is what demands the executable compile produced.",
    "The compile target hashes its bundle, packaging script, toolchain, fixture, and host target. Nx stores the gitignored dist/cli directory as its output."
  ],
  "nx": {
    "tags": [
      "layer:app"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "dependsOn": [
          "^build",
          {
            "projects": [
              "resvg-wasm"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "production",
          "^production",
          {
            "env": "SAERSKRIVEN_FONTS_DIR"
          },
          {
            "dependentTasksOutputFiles": "dist/resvg-wasm/lib/**/*",
            "transitive": false
          }
        ],
        "options": {
          "bundle": true,
          "outputFileName": "saer.js",
          "declaration": false,
          "thirdParty": true,
          "format": [
            "esm"
          ],
          "esbuildConfig": "apps/cli/esbuild.config.mts"
        }
      },
      "boundaries": {},
      "lint": {},
      "test": {
        "inputs": [
          "...",
          "cliTestFixtures",
          {
            "env": "SAERSKRIVEN_COMPILED_RUNNER"
          }
        ],
        "dependsOn": [
          "build"
        ]
      },
      "compile": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "{workspaceRoot}/scripts/package-cli.sh",
          "{workspaceRoot}/flake.nix",
          "{workspaceRoot}/flake.lock",
          "{workspaceRoot}/test-data/ecluse.json",
          {
            "json": "{workspaceRoot}/package.json",
            "fields": [
              "version"
            ]
          },
          {
            "env": "SAERSKRIVEN_DENORT_CACHE"
          },
          {
            "env": "SAERSKRIVEN_UNSHARE"
          },
          {
            "runtime": "deno --version"
          },
          {
            "runtime": "deno eval 'console.log(Deno.build.target)'"
          },
          "sharedGlobals",
          {
            "dependentTasksOutputFiles": "apps/cli/dist/**/*",
            "transitive": false
          }
        ],
        "outputs": [
          "{workspaceRoot}/dist/cli"
        ],
        "options": {
          "command": "scripts/package-cli.sh"
        },
        "configurations": {
          "all": {
            "command": "scripts/package-cli.sh --all"
          }
        }
      },
      "test-compiled": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "build",
          "compile"
        ],
        "inputs": [
          "default",
          "^production",
          "testConfiguration",
          "cliTestFixtures",
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "apps/cli/dist/**/*",
            "transitive": false
          },
          {
            "dependentTasksOutputFiles": "dist/cli/**/*",
            "transitive": false
          }
        ],
        "options": {
          "cwd": "apps/cli",
          "command": "vitest run src/runners.fixtures.spec.ts src/main.spec.ts src/mcp-session.spec.ts",
          "env": {
            "SAERSKRIVEN_COMPILED_RUNNER": "required"
          }
        }
      },
      "serve": {
        "executor": "@nx/js:node"
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@saerskriven/formats": "workspace:*",
    "@saerskriven/mcp": "workspace:*",
    "@saerskriven/model": "workspace:*",
    "@saerskriven/render": "workspace:*",
    "commander": "catalog:",
    "effect": "catalog:",
    "smol-toml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:"
  }
}
