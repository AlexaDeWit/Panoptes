{
  "name": "@saerskriven/studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "//": [
    "build repeats the Vite plugin's inferred inputs because a leaf override replaces them, then adds the environment inputs below.",
    "The studio emits external fonts, Pages metadata, and a browser-rendered card, so changes to their paths must invalidate the cached build."
  ],
  "dependencies": {
    "@radix-ui/react-icons": "catalog:",
    "@saerskriven/canvas": "workspace:*",
    "@saerskriven/formats": "workspace:*",
    "@saerskriven/model": "workspace:*",
    "@saerskriven/render": "workspace:*",
    "@xyflow/react": "catalog:",
    "effect": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@playwright/test": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "catalog:"
  },
  "nx": {
    "tags": [
      "layer:app"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "SAERSKRIVEN_FONTS_DIR"
          },
          {
            "env": "PAGES_BASE_PATH"
          },
          {
            "env": "PAGES_SITE_URL"
          },
          {
            "env": "PLAYWRIGHT_BROWSERS_PATH"
          },
          {
            "env": "PLAYWRIGHT_DRIVER_VERSION"
          },
          {
            "externalDependencies": [
              "vite",
              "@vitejs/plugin-react",
              "@playwright/test"
            ]
          },
          "viteGlobals",
          {
            "env": "SAERSKRIVEN_RELEASE_TAG"
          },
          {
            "env": "GITHUB_SHA"
          }
        ]
      },
      "boundaries": {},
      "lint": {},
      "test": {
        "inputs": [
          "...",
          "viteGlobals",
          {
            "env": "SAERSKRIVEN_RELEASE_TAG"
          },
          {
            "env": "GITHUB_SHA"
          },
          "studioTestFixtures",
          {
            "env": "SAERSKRIVEN_FONTS_DIR"
          },
          {
            "env": "PAGES_BASE_PATH"
          },
          {
            "env": "PAGES_SITE_URL"
          }
        ]
      }
    }
  }
}
