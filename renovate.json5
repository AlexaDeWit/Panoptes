{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // One bot for the ecosystems this repo automates: the pnpm catalog, GitHub
  // Actions, and the Nix flake. The npm manager edits catalog entries in
  // pnpm-workspace.yaml natively, so a bump lands in the one place a version
  // lives (the single version policy).
  extends: [
    'config:recommended',
    // Keep every GitHub Action pinned to a full commit SHA with the version
    // in a trailing comment (CODING.md, Workflows and CI). Renovate moves
    // the digest and the comment together and never unpins.
    'helpers:pinGitHubActionDigests',
    // config:recommended's group:monorepos already groups nx and the @nx/*
    // plugins (one source repo). Named here so the grouping survives a change
    // to the recommended preset.
    'group:nxMonorepo',
  ],

  // Weekly wave, early Saturday UTC, at the start of the weekend session.
  schedule: ['before 9am on saturday'],

  // Quarantine a version for a week after publication, mirroring pnpm's own
  // minimumReleaseAge (#16), so the wave never proposes a version pnpm
  // refuses to resolve.
  minimumReleaseAge: '7 days',

  // Withhold an update still inside the quarantine entirely, instead of
  // raising a PR that reports it as pending.
  internalChecksFilter: 'strict',

  // Conventional Commit subjects, matching the repo's commit rule.
  semanticCommits: 'enabled',

  // The nix manager is beta and off by default. Without this block neither
  // flake input bumps nor the flake.lock maintenance below run at all.
  nix: {
    enabled: true,
  },

  // OSV-based vulnerability alerting, and a fix for a known-vulnerable
  // dependency skips the quarantine above: that is the one case where
  // waiting is the greater risk.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  // The flake input tracks a branch (nixos-26.05) with no version to bump,
  // so a scheduled lock refresh is the only freshness lever for the
  // toolchain closure. Covers pnpm-lock.yaml drift too.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 9am on saturday'],
  },

  packageRules: [
    // Flake inputs and the lock refresh are toolchain moves.
    {
      matchManagers: ['nix'],
      semanticCommitType: 'build',
    },

    // Action bumps are CI moves.
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'ci',
    },

    // Playwright must not move independently of the nixpkgs browser pin in
    // flake.lock, which Renovate cannot bump in step. One grouped PR, held
    // for Dependency Dashboard approval; the version-equality test (#25)
    // reds a mismatch.
    {
      matchPackageNames: ['playwright', 'playwright-core', '@playwright/*'],
      groupName: 'playwright',
      dependencyDashboardApproval: true,
    },

    // The catalog pins typescript ~6.0.3: nx breaks on TS 7 before 7.1. A
    // major waits for Dependency Dashboard approval; #57 owns the adoption.
    {
      matchPackageNames: ['typescript'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
  ],
}
