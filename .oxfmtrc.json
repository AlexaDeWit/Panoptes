{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  // test-data holds files vendored from other projects byte for byte, so
  // their provenance checksums keep matching upstream. Reformatting one
  // would also make it a poor codec input: a codec has to read what the
  // foreign tool actually wrote.
  "ignorePatterns": ["test-data/"]
}
